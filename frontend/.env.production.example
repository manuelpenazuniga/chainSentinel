# ChainSentinel Frontend — Production env template
# Copy to Vercel project settings (Environment Variables → Production).
# All values here are PUBLIC — only NEXT_PUBLIC_* vars are exposed to the browser.

# REVM contracts (Paseo Hub Testnet)
NEXT_PUBLIC_VAULT_ADDRESS=0xb0C9621dA0339800b6741bEb0E3749911d259A4d
NEXT_PUBLIC_REGISTRY_ADDRESS=0x8ea34Df779a161f3Ef26Fb0f6Efd013f2D65A99F

# PVM contracts (optional — enables dual-VM display in dashboard)
NEXT_PUBLIC_VAULT_ADDRESS_PVM=0x7dd7bb5e7890702d4289df09f6126203531cad56
NEXT_PUBLIC_REGISTRY_ADDRESS_PVM=0x5623d94dea87b0e12f64be2f6e93e9a75a59bc6c

# RPC override (optional — leave unset to use the public Paseo endpoint).
# Set this if the public RPC starts rate-limiting during the demo.
# NEXT_PUBLIC_RPC_URL=https://services.polkadothub-rpc.com/testnet
